  "@testPlankResultHint": { "description": "Plank result hint" },
  "testPlankMeasuresDesc": "Isometric endurance of the core (abs, lower back, glutes). Predicts running and biking posture, lower back injury prevention, and force transfer efficiency.",
  "@testPlankMeasuresDesc": { "description": "Plank measures desc" },
  "testPlankStep1Main": "Position on forearms and feet: elbows right under shoulders, parallel forearms.",
  "@testPlankStep1Main": { "description": "Plank step 1 main" },
  "testPlankStep1Tip": "You can interlock your hands or keep them flat.",
  "@testPlankStep1Tip": { "description": "Plank step 1 tip" },
  "testPlankStep2Main": "Body completely straight from head to heels. Activate your abs as if you were about to be punched.",
  "@testPlankStep2Main": { "description": "Plank step 2 main" },
  "testPlankStep2Tip": "Do not let your hips rise or sag.",
  "@testPlankStep2Tip": { "description": "Plank step 2 tip" },
  "testPlankStep3Main": "Hold the fixed position looking down. Breathe continuously and in a controlled manner.",
  "@testPlankStep3Main": { "description": "Plank step 3 main" },
  "testPlankStep4Main": "The test ends when hips sag, rise excessively, or the body stops being straight.",
  "@testPlankStep4Main": { "description": "Plank step 4 main" },
  "testPlankStep4Tip": "FitnFlai records the time in seconds automatically.",
  "@testPlankStep4Tip": { "description": "Plank step 4 tip" },
  "testPlankError1": "Hips too high — body loses its straight line.",
  "@testPlankError1": { "description": "Plank error 1" },
  "testPlankError2": "Hips towards floor — compensates for core weakness.",
  "@testPlankError2": { "description": "Plank error 2" },
  "testPlankError3": "Holding breath — breathe continuously during the entire test.",
  "@testPlankError3": { "description": "Plank error 3" },
  "testPlankError4": "Elbows too far from shoulders — reduces exercise effectiveness.",
  "@testPlankError4": { "description": "Plank error 4" },
