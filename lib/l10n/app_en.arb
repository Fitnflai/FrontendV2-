  "testSquatsStep1Main": "Stand with feet shoulder-width apart. Toes slightly pointed outward (15–30°).",
  "@testSquatsStep1Main": { "description": "Squats step 1 main" },
  "testSquatsStep1Tip": "No special footwear is needed — barefoot works perfectly.",
  "@testSquatsStep1Tip": { "description": "Squats step 1 tip" },
  "testSquatsStep2Main": "Lower down until thighs are parallel to the floor — or as close as possible. Straight back, chest up.",
  "@testSquatsStep2Main": { "description": "Squats step 2 main" },
  "testSquatsStep2Tip": "If you don't reach parallel, go as low as you can without pain.",
  "@testSquatsStep2Tip": { "description": "Squats step 2 tip" },
  "testSquatsStep3Main": "Rise by pushing through your heels. Fully extend knees and hips when reaching the top.",
  "@testSquatsStep3Main": { "description": "Squats step 3 main" },
  "testSquatsStep3Tip": "Each rep counts only if you go all the way down AND all the way up.",
  "@testSquatsStep3Tip": { "description": "Squats step 3 tip" },
  "testSquatsStep4Main": "Repeat at a pace you can maintain for the full 60 seconds. You can pause briefly if needed.",
  "@testSquatsStep4Main": { "description": "Squats step 4 main" },
  "testSquatsStep4Tip": "The timer does not stop.",
  "@testSquatsStep4Tip": { "description": "Squats step 4 tip" },
  "testSquatsError1": "Knees caving in — knees should always follow the direction of the feet.",
  "@testSquatsError1": { "description": "Squats error 1" },
  "testSquatsError2": "Heels lifting — if this happens, widen stance or place something thin under heels.",
  "@testSquatsError2": { "description": "Squats error 2" },
  "testSquatsError3": "Rounded back — keep chest high throughout the movement.",
  "@testSquatsError3": { "description": "Squats error 3" },
