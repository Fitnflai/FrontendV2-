  "@testPushupsResultHint": { "description": "Pushups result hint" },
  "testPushupsMeasuresDesc": "Chest, shoulders, and triceps strength-endurance. Predicts your capacity to maintain posture on bike, swimming stroke power, and general stability.",
  "@testPushupsMeasuresDesc": { "description": "Pushups measures desc" },
  "testPushupsStep1Main": "Full plank position: hands shoulder-width apart, body straight from head to heels.",
  "@testPushupsStep1Main": { "description": "Pushups step 1 main" },
  "testPushupsStep1Tip": "Knees on the floor if you need to modify the difficulty.",
  "@testPushupsStep1Tip": { "description": "Pushups step 1 tip" },
  "testPushupsStep2Main": "Lower down until chest almost touches the floor. Elbows at 45° to your body — neither too flared nor tucked.",
  "@testPushupsStep2Main": { "description": "Pushups step 2 main" },
  "testPushupsStep2Tip": "Keep your abdomen contracted throughout the movement.",
  "@testPushupsStep2Tip": { "description": "Pushups step 2 tip" },
  "testPushupsStep3Main": "Rise by fully extending your elbows. Only full repetitions count: down AND up.",
  "@testPushupsStep3Main": { "description": "Pushups step 3 main" },
  "testPushupsStep4Main": "Repeat at a pace you can maintain for the full 60 seconds. You can pause briefly.",
  "@testPushupsStep4Main": { "description": "Pushups step 4 main" },
  "testPushupsStep4Tip": "The timer does not stop even if you pause.",
  "@testPushupsStep4Tip": { "description": "Pushups step 4 tip" },
  "testPushupsError1": "Lowering only halfway — chest must almost touch the floor.",
  "@testPushupsError1": { "description": "Pushups error 1" },
  "testPushupsError2": "Hips up or down — body must remain straight.",
  "@testPushupsError2": { "description": "Pushups error 2" },
  "testPushupsError3": "Elbows too wide (90°) — increases risk of shoulder injury.",
  "@testPushupsError3": { "description": "Pushups error 3" },
