  "testCooperResultHint": "Record the distance covered when finished",
  "@testCooperResultHint": { "description": "Cooper result hint" },
  "testCooperMeasuresDesc": "Maximal aerobic capacity (estimated VO2 Max). Predicts general endurance, recovery between sessions, and potential for cardiovascular improvement.",
  "@testCooperMeasuresDesc": { "description": "Cooper measures desc" },
  "testCooperStep1Main": "Look for a flat and measured track or path — ideally a 400m running track.",
  "@testCooperStep1Main": { "description": "Cooper step 1 main" },
  "testCooperStep1Tip": "A flat street with GPS tracking also works.",
  "@testCooperStep1Tip": { "description": "Cooper step 1 tip" },
  "testCooperStep2Main": "Warm up for 5 minutes by walking or jogging gently before starting the timer.",
  "@testCooperStep2Main": { "description": "Cooper step 2 main" },
  "testCooperStep3Main": "When starting, run or walk as fast as you can for exactly 12 minutes.",
  "@testCooperStep3Main": { "description": "Cooper step 3 main" },
  "testCooperStep3Tip": "Maintain a pace you can sustain — do not start too fast.",
  "@testCooperStep3Tip": { "description": "Cooper step 3 tip" },
  "testCooperStep4Main": "When finished, record the total distance covered in meters.",
  "@testCooperStep4Main": { "description": "Cooper step 4 main" },
  "testCooperStep4Tip": "FitnFlai will automatically calculate your estimated VO2 Max.",
  "@testCooperStep4Tip": { "description": "Cooper step 4 tip" },
  "testCooperError1": "Starting too fast and exhausting yourself in the first few minutes.",
  "@testCooperError1": { "description": "Cooper error 1" },
  "testCooperError2": "Taking long breaks — if you need to walk, it's fine, but keep moving.",
  "@testCooperError2": { "description": "Cooper error 2" },
  "testCooperError3": "Not measuring distance accurately — use GPS or a known track.",
  "@testCooperError3": { "description": "Cooper error 3" },
